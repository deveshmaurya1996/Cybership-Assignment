# Copy to `.env` and replace demo values with real UPS developer app credentials when calling CIE/production.
# The assessment does not require a working key; integration tests use stubbed HTTP (see `npm test`).

UPS_API_BASE_URL=https://wwwcie.ups.com/api
UPS_OAUTH_TOKEN_URL=https://wwwcie.ups.com/security/v1/oauth/token
UPS_CLIENT_ID=demo_client_id_replace_me
UPS_CLIENT_SECRET=demo_client_secret_replace_me
UPS_SHIPPER_NUMBER=123456
UPS_RATING_VERSION=v2409
UPS_TRANSACTION_SOURCE=cybership-carrier-integration
HTTP_TIMEOUT_MS=30000
UPS_TOKEN_SKEW_SECONDS=60
